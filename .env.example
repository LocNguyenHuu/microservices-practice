# SkyTurn — Environment Configuration
# Copy this file to .env and customize as needed.
# All values below are defaults used when .env is absent.

# ── Database ──────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Message Broker ────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ── Data Ingestion ────────────────────────────────────────────────
AVIATIONSTACK_API_KEY=
TARGET_AIRPORT=DXB
POLL_INTERVAL_MINUTES=30

# ── Weather (CheckWX METAR API) ─────────────────────────────────
# Leave blank to use simulated weather data (demo mode)
CHECKWX_API_KEY=
WEATHER_POLL_INTERVAL_MINUTES=15
